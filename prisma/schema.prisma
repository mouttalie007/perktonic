// PerkTonic.com — Prisma schema v1 (Phase 0; site renamed from ViralTrendly 2026-10-08)
// Public content model + settings + ads. Auth/session tables land in Phase 7.
// Every configurable frontend element has a data source here so the future
// Admin Dashboard can control it without schema churn.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
  AUTHOR
}

enum ArticleType {
  STANDARD // long-form article, HTML body, full SEO
  LISTICLE // Top N — each item renders as its own server-rendered subpage
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
  DELETED
}

// ----------------------------------------------------------------------------
// Users & Authors
// ----------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(AUTHOR)
  isActive     Boolean @default(true)

  authorProfile Author?
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Server-side, revocable admin sessions (Phase 7). The cookie holds only a
/// random token; we store its SHA-256 hash so a DB leak doesn't yield usable
/// sessions.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// Public-facing byline. May or may not be linked to a login account.
model Author {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  avatarUrl   String?
  bio         String?
  role        String? // e.g. "Staff Writer", "Editorial Team"
  email       String?
  socialLinks Json? // { x?, instagram?, facebook?, website? }

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("authors")
}

// ----------------------------------------------------------------------------
// Taxonomy
// ----------------------------------------------------------------------------

model Category {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  description      String?
  shortDescription String? // used on "Popular Categories" tiles
  imageUrl         String? // tile background
  iconKey          String? // icon identifier for quick-nav / tiles
  accentColor      String? // optional per-category accent
  order            Int     @default(0)

  // SEO
  seoTitle        String?
  metaDescription String?
  robotsIndex     Boolean @default(true)

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("categories")
}

model Tag {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  robotsIndex Boolean @default(false) // tag pages default to noindex (spec §31)

  articles ArticleTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tags")
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

// ----------------------------------------------------------------------------
// Articles
// ----------------------------------------------------------------------------

model Article {
  id      String      @id @default(cuid())
  type    ArticleType @default(STANDARD)
  title   String
  slug    String      @unique
  excerpt String?

  // STANDARD: sanitized HTML body. LISTICLE: `intro` + `items`.
  content String?
  intro   String?

  featuredImageId String?
  featuredImage   Media?  @relation("ArticleFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)

  authorId String?
  author   Author? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags          ArticleTag[]
  listicleItems ListicleItem[]
  reactions     ArticleReaction[]
  quiz          Quiz?
  comments      Comment[]

  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  scheduledFor DateTime?

  readingTime Int @default(0) // minutes
  viewCount   Int @default(0)

  isFeatured    Boolean @default(false)
  isTrending    Boolean @default(false)
  isBreaking    Boolean @default(false)
  trendingRank  Int?
  trendingScore Float?
  manualPriority Int?   // admin override for trending ordering (spec §61)

  // SEO (configurable separately from the visible title/excerpt)
  seoTitle        String?
  metaDescription String?
  canonicalUrl    String?
  ogImageId       String?
  ogImage         Media?  @relation("ArticleOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  robotsIndex     Boolean @default(true)
  robotsFollow    Boolean @default(true)

  // LISTICLE behaviour
  listicleIndexSubpages Boolean @default(true) // per-article subpage indexing toggle (spec discussion)

  // Ad control (spec §46). adOverrides: { [placementKey]: adUnitId | null }
  adsDisabled Boolean @default(false)
  adOverrides Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([type])
  @@index([categoryId])
  @@index([isTrending, trendingRank])
  @@index([isFeatured])
  @@map("articles")
}

/// One entry of a LISTICLE article. Rendered at /story/{slug}/{position}.
model ListicleItem {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  position Int // 1-based
  heading  String? // optional per-item title (strongly recommended for SEO)

  mediaId  String?
  media    Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  imageUrl String? // fallback when no Media row is attached
  imageAlt String?

  description String // item body — min length enforced in the app layer
  credit     String?
  sourceUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, position])
  @@index([articleId])
  @@map("listicle_items")
}

// ----------------------------------------------------------------------------
// Media
// ----------------------------------------------------------------------------

model Media {
  id         String  @id @default(cuid())
  url        String // canonical delivery URL (CDN)
  ogUrl      String? // 1200x630 (1.91:1) center-cropped variant, for social share previews only
  storageKey String? // provider object key / path
  provider   String  @default("local") // local | r2 | cloudinary
  filename   String
  mimeType   String?
  width      Int?
  height     Int?
  fileSize   Int?

  // SEO / attribution (spec §42, §68)
  alt       String?
  title     String?
  caption   String?
  credit    String?
  sourceUrl String?
  focalX    Float? // 0..1 — smart-crop focal point (future CMS)
  focalY    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articlesFeatured Article[]      @relation("ArticleFeaturedImage")
  articlesOg       Article[]      @relation("ArticleOgImage")
  listicleItems    ListicleItem[]

  @@map("media")
}

// ----------------------------------------------------------------------------
// Static / legal pages
// ----------------------------------------------------------------------------

model Page {
  id      String        @id @default(cuid())
  slug    String        @unique // "about", "privacy-policy", ...
  title   String
  content String? // sanitized HTML
  status  ContentStatus @default(PUBLISHED)

  seoTitle        String?
  metaDescription String?
  robotsIndex     Boolean @default(true)

  showInFooter Boolean @default(true)
  footerColumn String? // "quick-links" | "resources" | "company"
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

// ----------------------------------------------------------------------------
// Settings (singletons, id = "singleton")
// ----------------------------------------------------------------------------

model SiteSettings {
  id       String @id @default("singleton")
  siteName String @default("PerkTonic.com")
  siteUrl  String @default("https://perktonic.com")
  tagline  String @default("Find the good stuff before everyone else does.")

  logoUrl           String?
  defaultOgImageUrl String?
  contactEmail      String?

  facebookUrl  String?
  xUrl         String?
  instagramUrl String?
  youtubeUrl   String?
  tiktokUrl    String?

  newsletterProvider String?
  newsletterFromName String?

  tickerEnabled Boolean @default(true)

  // Admin-managed structured config
  homepageConfig   Json?
  navigationConfig Json?

  // Pre-launch demo engagement (perktonic workflow, 2026-10-09) — a pool of
  // generic comments the admin pastes in once; applyDemoEngagementToArticle
  // (src/lib/demo-engagement.ts) picks a random subset per article. One
  // comment per line. Cleared along with the demo Comment/ArticleReaction
  // rows by the "Clear demo engagement" button once real traffic exists.
  demoCommentPool String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model SeoSettings {
  id                     String  @id @default("singleton")
  defaultTitle           String  @default("PerkTonic: Free Stuff, Hidden Web Tricks & Smart Deals")
  titleTemplate          String  @default("%s — PerkTonic")
  defaultMetaDescription String  @default("Discover free samples, hidden Google features, free AI tools, rewards and money-saving tricks. Honest, tested guides updated regularly.")
  defaultRobotsIndex     Boolean @default(true)

  googleSiteVerification String?
  bingSiteVerification   String?

  organizationName    String  @default("PerkTonic")
  organizationLogoUrl String?
  twitterHandle       String? // "@perktonic"

  tagPagesIndexable    Boolean @default(false)
  searchPagesIndexable Boolean @default(false)

  // Analytics (spec §50) — admin-editable so it never needs a redeploy to
  // change. AnalyticsScripts fetches these via a small dynamic API route
  // rather than importing them directly, since a client-bundled value would
  // otherwise be frozen in at build time.
  ga4MeasurementId String? // "G-XXXXXXXXXX"
  gtmContainerId   String? // "GTM-XXXXXXX"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seo_settings")
}

// ----------------------------------------------------------------------------
// Advertising (spec §46 — publisher IDs live in env, never here)
// ----------------------------------------------------------------------------

/// A named block of ad markup the admin creates and reuses.
model AdUnit {
  id     String  @id @default(cuid())
  name   String // "Top Banner", "Under Title"
  key    String  @unique // machine key
  code   String // full AdSense <ins> snippet (or other network markup)
  format String? // auto | horizontal | rectangle | vertical

  enabled     Boolean @default(true)
  showDesktop Boolean @default(true)
  showTablet  Boolean @default(true)
  showMobile  Boolean @default(true)

  // CLS reservation
  reservedHeightDesktop Int?
  reservedHeightMobile  Int?

  placements AdPlacement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ad_units")
}

/// A slot in the page templates, mapped to an AdUnit globally by default.
/// Per-article overrides live on Article.adOverrides.
model AdPlacement {
  id           String  @id @default(cuid())
  placementKey String  @unique // top-leaderboard | under-title | in-content | between-slides | sidebar | below-article | mobile-anchor
  label        String
  description  String?

  adUnitId String?
  adUnit   AdUnit? @relation(fields: [adUnitId], references: [id], onDelete: SetNull)

  enabled Boolean @default(true)
  order   Int     @default(0)

  // in-content auto injection
  autoInject       Boolean      @default(false)
  everyNParagraphs Int?
  maxInjections    Int?
  appliesTo        ArticleType? // null = both types

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ad_placements")
}

// ----------------------------------------------------------------------------
// Redirects & Newsletter
// ----------------------------------------------------------------------------

model Redirect {
  id         String  @id @default(cuid())
  fromPath   String  @unique
  toPath     String
  statusCode Int     @default(301)
  enabled    Boolean @default(true)
  hits       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("redirects")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("pending") // pending | subscribed | unsubscribed
  source         String? // "homepage" | "article" | "footer"
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

/// Contact form submissions (spec §22). No outbound email provider is wired
/// yet, so submissions land here for an editor to read in the admin.
model ContactMessage {
  id      String @id @default(cuid())
  name    String
  email   String
  subject String
  message String

  status String @default("new") // new | read | archived

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@map("contact_messages")
}

// ----------------------------------------------------------------------------
// Engagement: reactions & comments (homepage redesign, 2026-09-12)
// ----------------------------------------------------------------------------

enum ReactionEmoji {
  LAUGH // 😂
  LOVE // 😍
  WOW // 😮
  ANGRY // 😡
  SAD // 😢
}

/// Aggregate reaction counters per article/emoji. Anonymous — there is no
/// public user account system — so double-counting from the same visitor is
/// only soft-guarded (client localStorage + a per-IP rate limit on the
/// action), not cryptographically prevented. That's an accepted trade-off
/// consistent with how this kind of lightweight reaction bar works site-wide
/// on comparable publishers.
model ArticleReaction {
  id        String        @id @default(cuid())
  articleId String
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  emoji     ReactionEmoji
  count     Int           @default(0)

  @@unique([articleId, emoji])
  @@map("article_reactions")
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

/// Flat (non-threaded) public comments. Default PENDING — an editor
/// approves/marks-spam from the admin before a comment appears publicly, the
/// same moderation posture as ContactMessage. No account system, so `name`
/// is free text; `ipHash` (SHA-256, never the raw IP) backs the submit rate
/// limit and gives an editor a spam-pattern signal without storing PII.
model Comment {
  id        String        @id @default(cuid())
  articleId String
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  name      String
  body      String
  status    CommentStatus @default(PENDING)
  ipHash    String?
  // Seeded by applyDemoEngagementToArticle (src/lib/demo-engagement.ts), not
  // a real visitor — lets "Clear demo engagement" delete precisely these
  // rows without risking any genuine comment received in the meantime.
  isSeed    Boolean       @default(false)
  // Demo comments only — fetched once from randomuser.me at seed time and
  // stored directly (never fetched live on page render). Null for every
  // real visitor comment; the UI falls back to initials when absent.
  avatarUrl String?

  createdAt DateTime @default(now())

  @@index([articleId, status, createdAt])
  @@index([status, createdAt])
  @@map("comments")
}

// ----------------------------------------------------------------------------
// Quick Article prompt queue (2026-09-28)
// ----------------------------------------------------------------------------

/// One pre-written, ready-to-copy ChatGPT prompt for a specific writer +
/// title, imported once from a local folder of 210 hand-prepared prompts
/// (see scripts/import-prompt-queue.ts). The admin's "Quick Article" tab
/// serves a random `pending` row, the editor copies `promptText` into
/// ChatGPT, pastes the reply back, and the row flips to `used` only once
/// the resulting article is actually saved — never at copy time, so an
/// abandoned draft doesn't burn a topic.
model PromptQueueItem {
  id         String  @id @default(cuid())
  writerSlug String // matches Author.slug (alex-carter | mia-reynolds | daniel-brooks)
  writerName String // denormalized for display without a join
  category   String // resolved to a real Category.name at import time

  title      String
  promptText String // the full production prompt, with the output-format addendum already appended

  status            String    @default("pending") // pending | used
  usedAt            DateTime?
  resultArticleSlug String?

  createdAt DateTime @default(now())

  @@index([status])
  @@map("prompt_queue_items")
}

// ----------------------------------------------------------------------------
// Article Quiz (2026-10-11)
// ----------------------------------------------------------------------------

/// A 10-question quiz tied 1:1 to an Article, surfaced as a "Test your
/// knowledge" CTA at the bottom of the article. No right/wrong answers are
/// tracked -- picking any option just advances to the next question; the
/// payoff is a redemption code (QuizCode) after finishing + sharing.
model Quiz {
  id        String  @id @default(cuid())
  articleId String  @unique
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  title String

  questions QuizQuestion[]
  codes     QuizCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quizzes")
}

/// One question of a Quiz. Exactly 3 options, in order; no correct answer
/// is stored (spec call: the visitor never sees right/wrong).
model QuizQuestion {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  position Int // 1-10
  question String
  options  String[] // exactly 3 choices

  @@unique([quizId, position])
  @@map("quiz_questions")
}

/// A code minted fresh for a single visitor the moment they finish a quiz
/// and share the article -- not pre-generated by the admin. Globally unique
/// forever (never reused). A future lookup page lets the admin paste a code
/// to see which article it's from; isChecked/checkedAt track whether that
/// lookup has already happened once, so a second lookup of the same code
/// can say "already checked" instead of silently succeeding again.
model QuizCode {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  code String @unique // 4-char alphanumeric, e.g. "X6E8"

  isChecked Boolean   @default(false)
  checkedAt DateTime?

  createdAt DateTime @default(now())

  @@index([quizId])
  @@map("quiz_codes")
}
