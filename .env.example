# ViralTrendly — environment variables
# Copy to .env.local for local development. Never commit real secrets.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL of the site (no trailing slash). Used for canonical URLs,
# sitemap, RSS, Open Graph, structured data.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Database (Prisma / PostgreSQL)
# ---------------------------------------------------------------------------
# Matches docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://viraltrendly:viraltrendly_dev@localhost:5433/viraltrendly?schema=public"

# ---------------------------------------------------------------------------
# Google AdSense  (spec §11, §46 — publisher/slot IDs are NEVER hard-coded)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_ENABLED="false"
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=""        # e.g. ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_AUTO_ADS="false"
# Value for /ads.txt (one line). Left blank until an AdSense account exists.
ADS_TXT_CONTENT=""

# ---------------------------------------------------------------------------
# Analytics  (spec §50 — configurable, not hard-coded)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""          # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=""            # e.g. GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ---------------------------------------------------------------------------
# Media storage  (Phase 7 wires uploads; local disk is the Phase 0 default)
# ---------------------------------------------------------------------------
MEDIA_PROVIDER="local"                     # local | r2 | cloudinary
MEDIA_PUBLIC_BASE_URL="/uploads"
# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Newsletter  (Phase 8 — abstraction only for now)
# ---------------------------------------------------------------------------
NEWSLETTER_PROVIDER=""                     # mailchimp | buttondown | ...
NEWSLETTER_API_KEY=""
NEWSLETTER_LIST_ID=""

# ---------------------------------------------------------------------------
# Auth  (Phase 7)
# ---------------------------------------------------------------------------
AUTH_SECRET=""                            # generate with: openssl rand -base64 32
