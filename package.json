{
  "name": "perktonic",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "start:cpanel": "node server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:prod": "prisma db seed -- --production",
    "db:import-prompts": "node scripts/import-prompt-queue.mjs",
    "db:import-briefs": "node scripts/import-article-briefs.mjs",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "audit": "node scripts/responsive-audit.mjs",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "audit:perf": "node scripts/perf-audit.mjs"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@cfworker/json-schema": "4.1.1",
    "@eslint-community/regexpp": "4.12.2",
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "@mixmark-io/domino": "2.2.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "5.0.6",
    "acorn": "8.19.0",
    "bcryptjs": "^3.0.3",
    "cronstrue": "3.31.0",
    "docx": "9.15.1",
    "dompurify": "3.4.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "i18n-iso-countries": "7.14.0",
    "jq-wasm": "3.0.0-jq-1.8.2",
    "jsonpath-plus": "11.2.1",
    "libphonenumber-js": "1.13.15",
    "mammoth": "1.13.0",
    "marked": "16.4.2",
    "mermaid": "11.17.2",
    "next": "16.4.3",
    "node-html-parser": "^9.0.4",
    "node-sql-parser": "5.4.0",
    "nodemailer": "7.0.10",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.10",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "smol-toml": "1.9.1",
    "tailwindcss": "^4",
    "tesseract.js": "7.0.0",
    "tsx": "^4.23.13",
    "turndown": "7.2.4",
    "typescript": "^5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "jsdom": "30.1.2",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "vite": "8.3.5",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "@prisma/client": true,
    "prisma": true,
    "esbuild": true,
    "unrs-resolver": true
  }
}
