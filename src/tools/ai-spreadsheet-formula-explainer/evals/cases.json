[
  {
    "id": "let-filter-sample",
    "input": {
      "formula": "=LET(sales,FILTER(Sales[Amount],(Sales[Region]=\"North\")*(MONTH(Sales[Date])=3),0),IF(SUM(sales)=0,\"No sales\",ROUND(AVERAGE(sales),2)))",
      "sampleValues": "Sales is an Excel table with Date (real dates), Region (North, South, East) and Amount (numbers)."
    },
    "expect": {
      "status": "ok",
      "mustContain": [
        "North",
        "March|month (number )?3|\\b3\\b"
      ],
      "mustNotContain": []
    }
  },
  {
    "id": "vlookup-iferror",
    "input": {
      "formula": "=IFERROR(VLOOKUP(A2,Prices!A:C,3,FALSE),\"Not found\")",
      "sampleValues": ""
    },
    "expect": {
      "status": "ok",
      "mustContain": [
        "Not found"
      ],
      "mustNotContain": []
    }
  },
  {
    "id": "deep-nested-8-levels",
    "input": {
      "formula": "=IFERROR(IF(AND(ISNUMBER(SEARCH(\"vip\",LOWER(TRIM(INDEX(Customers!B:B,MATCH(A2,Customers!A:A,0)))))),C2>1000),\"VIP\",\"Standard\"),\"Unknown\")",
      "sampleValues": ""
    },
    "expect": {
      "status": "ok",
      "mustContain": [
        "VIP",
        "Standard"
      ],
      "mustNotContain": []
    }
  },
  {
    "id": "array-constant-weights",
    "input": {
      "formula": "=SUMPRODUCT(B2:B5*{0.1;0.2;0.3;0.4})",
      "sampleValues": ""
    },
    "expect": {
      "status": "ok",
      "mustContain": [
        "B2:B5"
      ],
      "mustNotContain": []
    }
  },
  {
    "id": "structured-refs",
    "input": {
      "formula": "=SUMIFS(Orders[Total],Orders[Status],\"Paid\",Orders[Date],\">=\"&DATE(2026,1,1))",
      "sampleValues": ""
    },
    "expect": {
      "status": "ok",
      "mustContain": [
        "Paid",
        "Total"
      ],
      "mustNotContain": []
    }
  },
  {
    "id": "lambda-called-inline",
    "input": {
      "formula": "=LAMBDA(x,y,SQRT(x^2+y^2))(B2,C2)",
      "sampleValues": ""
    },
    "expect": {
      "status": "ok",
      "mustContain": [
        "B2",
        "C2"
      ],
      "mustNotContain": []
    }
  },
  {
    "id": "sheets-query",
    "input": {
      "formula": "=QUERY(A1:D100,\"select B, sum(D) where C = 'Open' group by B\",1)",
      "sampleValues": "A: Date, B: Owner, C: Status, D: Hours"
    },
    "expect": {
      "status": "ok",
      "mustContain": [
        "Open"
      ],
      "mustNotContain": []
    }
  },
  {
    "id": "text-with-brackets-and-quotes",
    "input": {
      "formula": "=IF(A1=\"say \"\"hi\"\" (now), ok; really\",CONCAT(\"(\",B1,\")\"),\"a,b\")",
      "sampleValues": ""
    },
    "expect": {
      "status": "ok",
      "mustContain": [
        "B1"
      ],
      "mustNotContain": []
    }
  },
  {
    "id": "does-not-calculate-samples",
    "input": {
      "formula": "=AVERAGE(B2:B4)",
      "sampleValues": "B2 = 10, B3 = 20, B4 = 60"
    },
    "expect": {
      "status": "ok",
      "mustContain": [
        "B2:B4"
      ],
      "mustNotContain": [
        "(is|equals|gives|returns) (about )?30\\b"
      ]
    }
  },
  {
    "id": "index-two-way",
