# ViralTrendly — PRODUCTION environment template
#
# Copy to `.env` inside /srv/viraltrendly/ on the VPS (never commit the real
# file — .gitignore already blocks any `.env*` except this template). Fill
# in every value below before starting the systemd service.
#
# Matches the agreed VPS layout (memory: viraltrendly-vps): app on
# 127.0.0.1:3100 behind nginx, own native PostgreSQL on 127.0.0.1:5432,
# files under /srv/viraltrendly/.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://viraltrendly.com"
NODE_ENV="production"
PORT="3100"

# ---------------------------------------------------------------------------
# Database (Prisma / PostgreSQL)
# ---------------------------------------------------------------------------
# Native Postgres on the VPS itself (not the dev docker-compose setup) —
# create the role/database first (see the deploy runbook), then fill this in.
DATABASE_URL="postgresql://viraltrendly:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/viraltrendly?schema=public"

# ---------------------------------------------------------------------------
# Admin bootstrap (read once by `npm run db:seed:prod`, not by the app itself)
# ---------------------------------------------------------------------------
# Real admin login email. The seed script generates and prints a random
# password ONCE on first run — change it immediately via /admin -> My
# Account, then this var no longer matters.
ADMIN_EMAIL="mouttaliof@gmail.com"

# ---------------------------------------------------------------------------
# Google AdSense (spec §11, §46) — leave disabled until a real AdSense
# account + Ad Units exist. Flip NEXT_PUBLIC_ADSENSE_ENABLED only once
# publisher ID is set, and only after the consent banner is live (it is).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_ENABLED="false"
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=""        # e.g. ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_AUTO_ADS="false"
ADS_TXT_CONTENT=""                         # real ads.txt line once AdSense exists

# ---------------------------------------------------------------------------
# Analytics (spec §50) — optional, leave blank to ship with none
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""          # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=""            # e.g. GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ---------------------------------------------------------------------------
# Media storage — "local" works out of the box (files under
# /srv/viraltrendly/public/uploads, served same-origin, Cloudflare caches
# them anyway). Switch to r2/cloudinary later if/when you want an external
# CDN-backed store; until then leave the R2_*/CLOUDINARY_* vars blank.
# ---------------------------------------------------------------------------
MEDIA_PROVIDER="local"
MEDIA_PUBLIC_BASE_URL="/uploads"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Newsletter (Phase 8 — abstraction only; leave blank until a provider is
# actually wired up, subscribers still collect in the DB either way)
# ---------------------------------------------------------------------------
NEWSLETTER_PROVIDER=""
NEWSLETTER_API_KEY=""
NEWSLETTER_LIST_ID=""

# ---------------------------------------------------------------------------
# Auth — NOTE: checked 2026-09-13, this variable is validated by
# src/config/env.server.ts but not actually read anywhere else in the code.
# Sessions use random opaque tokens (SHA-256-hashed in the DB), not a
# signed/HMAC scheme, so nothing currently depends on this being set. Left
# in for whoever wires up a signed-token scheme later; safe to leave blank.
# ---------------------------------------------------------------------------
AUTH_SECRET=""
